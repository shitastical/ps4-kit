From ee9d0cbb5f978cb8148f2df139f775d0758cfb7d Mon Sep 17 00:00:00 2001
From: ShiroKlein <23220202+iHaiDeeZ@users.noreply.github.com>
Date: Fri, 2 Oct 2026 23:22:17 +0300
Subject: [PATCH 12/35] PS4: check each IB start when recording leaves it
 (catches overwrites during recording)

---
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index e7da9a9d0b1..03c1209e1a5 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -411,10 +411,34 @@ radv_amdgpu_restore_last_ib(struct radv_amdgpu_cs *cs)
    cs->ib_buffer = ib->bo;
 }
 
+#ifdef __PS4__
+/* PS4 port: is the start of the IB we are leaving still what RADV wrote? (Something overwrote the
+ * first dwords of chained IBs on the PS4; this tells whether it happened during recording.) */
+static void
+radv_ps4_check_ib_start(struct radv_amdgpu_cs *cs, const char *where)
+{
+   if (!cs->base.cdw || !cs->ib_buffer)
+      return;
+   const uint32_t h = cs->base.buf[0];
+   if (h >> 30 == 3 || h >> 30 == 2)
+      return;
+   static unsigned logged;
+   if (logged++ < 8)
+      fprintf(stderr,
+              "radv/ps4: IB %#llx overwritten DURING RECORDING (seen at %s, %u dwords written): "
+              "%08x %08x %08x %08x\n",
+              (unsigned long long)radv_amdgpu_winsys_bo(cs->ib_buffer)->base.va, where,
+              cs->base.cdw, cs->base.buf[0], cs->base.buf[1], cs->base.buf[2], cs->base.buf[3]);
+}
+#endif
+
 static void
 radv_amdgpu_cs_grow(struct ac_cmdbuf *_cs, size_t min_size)
 {
    struct radv_amdgpu_cs *cs = radv_amdgpu_cs(_cs);
+#ifdef __PS4__
+   radv_ps4_check_ib_start(cs, "grow");
+#endif
 
    if (cs->status != VK_SUCCESS) {
       cs->base.cdw = 0;
@@ -499,6 +523,10 @@ radv_amdgpu_cs_finalize(struct ac_cmdbuf *_cs)
 
    assert(cs->base.cdw <= cs->base.reserved_dw);
 
+#ifdef __PS4__
+   radv_ps4_check_ib_start(cs, "finalize");
+#endif
+
    if (cs->chain_ib) {
       /* Pad with NOPs but leave 4 dwords for INDIRECT_BUFFER. */
       radv_amdgpu_winsys_cs_pad(_cs, 4);
-- 
