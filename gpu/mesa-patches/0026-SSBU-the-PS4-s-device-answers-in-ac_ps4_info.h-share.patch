+#ifdef AC_PS4_HOST_IDENTITY
+/* A PC build that compiles shaders for the PS4 (the SSBU port's shader pack): the device these
+ * queries describe is the PS4's, as ac_ps4_drm.c answers them on the console (ac_ps4_info.h),
