From 4dc1e7cb6b006aace43e5bd6862e58ad3170f1d7 Mon Sep 17 00:00:00 2001
From: ShiroKlein <23220202+iHaiDeeZ@users.noreply.github.com>
Date: Fri, 2 Oct 2026 17:49:29 +0300
Subject: [PATCH 06/34] PS4: trace winsys failures

---
 src/amd/common/ac_ps4_drm.c                   | 31 +++++++++++++---
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c | 35 +++++++++++--------
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c | 25 ++++++++-----
 3 files changed, 64 insertions(+), 27 deletions(-)

diff --git a/src/amd/common/ac_ps4_drm.c b/src/amd/common/ac_ps4_drm.c
index 231af394e4e..bfcdf32779b 100755
--- a/src/amd/common/ac_ps4_drm.c
+++ b/src/amd/common/ac_ps4_drm.c
@@ -254,6 +254,10 @@ ps4_reserve(uint64_t addr, uint64_t size)
 
 static struct util_sync_provider *ps4_sync_provider_init(ac_drm_device *dev);
 
+/* Logs the first memory operations (bring-up). */
+static unsigned ps4_verbose_left = 64;
+#define PS4_VERBOSE(...) do { if (ps4_verbose_left) { ps4_verbose_left--; ps4_log(__VA_ARGS__); } } while (0)
+
 int
 ac_drm_device_initialize(int fd, bool is_virtio, uint32_t *major_version, uint32_t *minor_version,
                          ac_drm_device **out)
@@ -374,6 +378,9 @@ ac_drm_bo_alloc(ac_drm_device *dev, struct amdgpu_bo_alloc_request *req, ac_drm_
    simple_mtx_unlock(&dev->lock);
 
    out->abo = bo;
+   PS4_VERBOSE("radv/ps4: bo %u: %llu bytes, heap %#x, flags %#llx, align %#llx, phys %#llx\n",
+               bo->handle, (unsigned long long)bo->size, bo->heap, (unsigned long long)bo->flags,
+               (unsigned long long)align, (unsigned long long)bo->phys);
    return 0;
 }
 
@@ -426,8 +433,10 @@ ac_drm_bo_cpu_map(ac_drm_device *dev, ac_drm_bo bo, void **cpu)
    if (!b->cpu) {
       void *addr = NULL;
       if (sceKernelMapDirectMemory(&addr, b->size, PS4_PROT_CPU_RW | PS4_PROT_GPU_RW, 0, b->phys,
-                                   PS4_PAGE))
+                                   PS4_PAGE)) {
+         ps4_log("radv/ps4: cpu map of bo %u failed\n", b->handle);
          return -ENOMEM;
+      }
       b->cpu = addr;
       b->cpu_owned = true;
    }
@@ -474,14 +483,19 @@ ps4_va_op(ac_drm_device *dev, uint32_t bo_handle, uint64_t offset, uint64_t size
           uint64_t flags, uint32_t ops)
 {
    size = align64(size, PS4_PAGE);
-   if (flags & AMDGPU_VM_PAGE_PRT)
+   if (flags & AMDGPU_VM_PAGE_PRT) {
+      ps4_log("radv/ps4: sparse (PRT) mapping requested - unsupported\n");
       return -ENOSYS; /* no sparse residency */
+   }
 
    switch (ops) {
    case AMDGPU_VA_OP_MAP: {
       struct amdgpu_bo *b = ps4_bo(dev, bo_handle);
-      if (!b || offset + size > b->size)
+      if (!b || offset + size > b->size) {
+         ps4_log("radv/ps4: map of bo %u (+%#llx, %#llx bytes) out of range\n", bo_handle,
+                 (unsigned long long)offset, (unsigned long long)size);
          return -EINVAL;
+      }
       void *a = (void *)(uintptr_t)addr;
       int r = sceKernelMapDirectMemory(&a, size, PS4_PROT_CPU_RW | PS4_PROT_GPU_RW, PS4_MAP_FIXED,
                                        b->phys + offset, PS4_PAGE);
@@ -493,6 +507,8 @@ ps4_va_op(ac_drm_device *dev, uint32_t bo_handle, uint64_t offset, uint64_t size
       }
       if (offset == 0 && !b->cpu)
          b->cpu = a;
+      PS4_VERBOSE("radv/ps4: map bo %u +%#llx at %#llx (%#llx bytes)\n", b->handle,
+                  (unsigned long long)offset, (unsigned long long)addr, (unsigned long long)size);
       return 0;
    }
    case AMDGPU_VA_OP_UNMAP:
@@ -504,6 +520,7 @@ ps4_va_op(ac_drm_device *dev, uint32_t bo_handle, uint64_t offset, uint64_t size
       return ps4_reserve(addr, size) ? 0 : -EINVAL;
    }
    default:
+      ps4_log("radv/ps4: va op %u unsupported\n", ops);
       return -ENOSYS;
    }
 }
@@ -557,8 +574,14 @@ ac_drm_va_range_alloc(ac_drm_device *dev, enum amdgpu_gpu_va_range va_range_type
       addr = util_vma_heap_alloc(heap, size, align);
    }
    simple_mtx_unlock(&ps4_va_lock);
-   if (!addr)
+   if (!addr) {
+      ps4_log("radv/ps4: va_range_alloc(%#llx, align %#llx, required %#llx, flags %#llx) failed\n",
+              (unsigned long long)size, (unsigned long long)align,
+              (unsigned long long)va_base_required, (unsigned long long)flags);
       return -ENOMEM;
+   }
+   PS4_VERBOSE("radv/ps4: va %#llx + %#llx (flags %#llx)\n", (unsigned long long)addr,
+               (unsigned long long)size, (unsigned long long)flags);
 
    struct amdgpu_va *va = malloc(sizeof(*va));
    va->heap = heap;
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index bdfd6eab0c5..fb84e4bab9a 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -28,6 +28,13 @@
 #include "util/u_math.h"
 #include "util/u_memory.h"
 
+#ifdef __PS4__
+void ac_ps4_trace(const char *fmt, ...);
+#define PS4_FAIL(label) do { ac_ps4_trace("radv: %s:%d -> " #label "\n", __FILE__, __LINE__); goto label; } while (0)
+#else
+#define PS4_FAIL(label) goto label
+#endif
+
 static void radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo *_bo);
 
 static int
@@ -529,7 +536,7 @@ radv_amdgpu_winsys_virtual_bo_create(struct radeon_winsys *_ws, uint64_t size, u
                              &va, &va_handle, va_flags);
    if (r) {
       result = replay_address ? VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS : VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_va_alloc;
+      PS4_FAIL(error_va_alloc);
    }
 
    bo->base.va = va;
@@ -540,7 +547,7 @@ radv_amdgpu_winsys_virtual_bo_create(struct radeon_winsys *_ws, uint64_t size, u
    ranges = realloc(NULL, sizeof(struct radv_amdgpu_map_range));
    if (!ranges) {
       result = VK_ERROR_OUT_OF_HOST_MEMORY;
-      goto error_ranges_alloc;
+      PS4_FAIL(error_ranges_alloc);
    }
 
    u_rwlock_init(&bo->lock);
@@ -559,7 +566,7 @@ radv_amdgpu_winsys_virtual_bo_create(struct radeon_winsys *_ws, uint64_t size, u
    if (r) {
       fprintf(stderr, "radv/amdgpu: Failed to reserve a PRT VA region (%d).\n", r);
       result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_ranges_alloc;
+      PS4_FAIL(error_ranges_alloc);
    }
 
    radv_amdgpu_log_bo(ws, bo, false);
@@ -617,7 +624,7 @@ radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned
                              &va, &va_handle, va_flags);
    if (r) {
       result = replay_address ? VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS : VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_va_alloc;
+      PS4_FAIL(error_va_alloc);
    }
 
    bo->base.va = va;
@@ -698,7 +705,7 @@ radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned
       fprintf(stderr, "radv/amdgpu:    alignment : %u bytes\n", alignment);
       fprintf(stderr, "radv/amdgpu:    domains   : %u\n", initial_domain);
       result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_bo_alloc;
+      PS4_FAIL(error_bo_alloc);
    }
 
    uint32_t kms_handle = 0;
@@ -708,7 +715,7 @@ radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned
    r = radv_amdgpu_bo_va_op(ws, kms_handle, 0, size, va, flags, 0, AMDGPU_VA_OP_MAP);
    if (r) {
       result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_va_map;
+      PS4_FAIL(error_va_map);
    }
 
    if (flags & RADEON_FLAG_VM_PAD_1PAGE) {
@@ -717,7 +724,7 @@ radv_amdgpu_winsys_bo_create(struct radeon_winsys *_ws, uint64_t size, unsigned
                                AMDGPU_VA_OP_MAP);
       if (r) {
          result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-         goto error_va_map;
+         PS4_FAIL(error_va_map);
       }
    }
 
@@ -885,7 +892,7 @@ radv_amdgpu_winsys_bo_from_ptr(struct radeon_winsys *_ws, void *pointer, uint64_
       } else {
          result = VK_ERROR_UNKNOWN;
       }
-      goto error;
+      PS4_FAIL(error);
    }
 
    /* Using the optimal VM alignment also fixes GPU hangs for buffers that
@@ -896,7 +903,7 @@ radv_amdgpu_winsys_bo_from_ptr(struct radeon_winsys *_ws, void *pointer, uint64_
    if (ac_drm_va_range_alloc(ws->dev, amdgpu_gpu_va_range_general, size, vm_alignment, 0, &va, &va_handle,
                              AMDGPU_VA_RANGE_HIGH)) {
       result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_va_alloc;
+      PS4_FAIL(error_va_alloc);
    }
 
    uint32_t kms_handle = 0;
@@ -905,7 +912,7 @@ radv_amdgpu_winsys_bo_from_ptr(struct radeon_winsys *_ws, void *pointer, uint64_
 
    if (radv_amdgpu_bo_va_op(ws, kms_handle, 0, size, va, 0, 0, AMDGPU_VA_OP_MAP)) {
       result = VK_ERROR_UNKNOWN;
-      goto error_va_map;
+      PS4_FAIL(error_va_map);
    }
 
    /* Initialize it */
@@ -966,7 +973,7 @@ radv_amdgpu_winsys_bo_from_fd(struct radeon_winsys *_ws, int fd, unsigned priori
    r = ac_drm_bo_import(ws->dev, type, fd, &result);
    if (r) {
       vk_result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
-      goto error;
+      PS4_FAIL(error);
    }
 
    uint32_t kms_handle = 0;
@@ -976,7 +983,7 @@ radv_amdgpu_winsys_bo_from_fd(struct radeon_winsys *_ws, int fd, unsigned priori
    r = ac_drm_bo_query_info(ws->dev, kms_handle, &info);
    if (r) {
       vk_result = VK_ERROR_UNKNOWN;
-      goto error_query;
+      PS4_FAIL(error_query);
    }
 
    if (alloc_size) {
@@ -987,13 +994,13 @@ radv_amdgpu_winsys_bo_from_fd(struct radeon_winsys *_ws, int fd, unsigned priori
                              AMDGPU_VA_RANGE_HIGH);
    if (r) {
       vk_result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_query;
+      PS4_FAIL(error_query);
    }
 
    r = radv_amdgpu_bo_va_op(ws, kms_handle, 0, result.alloc_size, va, 0, 0, AMDGPU_VA_OP_MAP);
    if (r) {
       vk_result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
-      goto error_va_map;
+      PS4_FAIL(error_va_map);
    }
 
    if (info.preferred_heap & AMDGPU_GEM_DOMAIN_VRAM)
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index a3c7370723b..e7da9a9d0b1 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -101,6 +101,13 @@ struct radv_winsys_sem_info {
    struct radv_winsys_sem_counts signal;
 };
 
+#ifdef __PS4__
+void ac_ps4_trace(const char *fmt, ...);
+#define PS4_FAIL(label) do { ac_ps4_trace("radv: %s:%d -> " #label "\n", __FILE__, __LINE__); goto label; } while (0)
+#else
+#define PS4_FAIL(label) goto label
+#endif
+
 static void
 radeon_emit_unchecked(struct ac_cmdbuf *cs, uint32_t value)
 {
@@ -1115,7 +1122,7 @@ radv_amdgpu_winsys_cs_submit_internal(struct radv_amdgpu_ctx *ctx, int queue_idx
                                     continue_preamble_cs, continue_preamble_count, postamble_cs, postamble_count,
                                     &num_handles, &handles);
    if (result != VK_SUCCESS)
-      goto fail;
+      PS4_FAIL(fail);
 
    /* Configure the CS request. */
    const uint32_t *max_ib_per_ip = ws->info.max_submitted_ibs;
@@ -1227,13 +1234,13 @@ radv_amdgpu_winsys_cs_submit_internal(struct radv_amdgpu_ctx *ctx, int queue_idx
       request.number_of_ibs = num_submitted_ibs;
       result = radv_amdgpu_cs_submit(ctx, &request, sem_info);
       if (result != VK_SUCCESS)
-         goto fail;
+         PS4_FAIL(fail);
    }
 
    free(request.handles);
 
    if (result != VK_SUCCESS)
-      goto fail;
+      PS4_FAIL(fail);
 
    radv_assign_last_submit(ctx, &request);
 
@@ -1630,11 +1637,11 @@ radv_amdgpu_ctx_create(struct radeon_winsys *_ws, enum radeon_ctx_priority prior
    r = ac_drm_cs_ctx_create2(ws->dev, amdgpu_priority, &ctx->ctx_handle);
    if (r && r == -EACCES) {
       result = VK_ERROR_NOT_PERMITTED;
-      goto fail_create;
+      PS4_FAIL(fail_create);
    } else if (r) {
       fprintf(stderr, "radv/amdgpu: radv_amdgpu_cs_ctx_create2 failed. (%i)\n", r);
       result = VK_ERROR_OUT_OF_HOST_MEMORY;
-      goto fail_create;
+      PS4_FAIL(fail_create);
    }
    ctx->ws = ws;
 
@@ -1643,7 +1650,7 @@ radv_amdgpu_ctx_create(struct radeon_winsys *_ws, enum radeon_ctx_priority prior
                                    RADEON_FLAG_CPU_ACCESS | RADEON_FLAG_NO_INTERPROCESS_SHARING, RADV_BO_PRIORITY_CS, 0,
                                    &ctx->fence_bo);
    if (result != VK_SUCCESS) {
-      goto fail_alloc;
+      PS4_FAIL(fail_alloc);
    }
 
    *rctx = (struct radeon_winsys_ctx *)ctx;
@@ -1867,7 +1874,7 @@ radv_amdgpu_cs_submit(struct radv_amdgpu_ctx *ctx, struct radv_amdgpu_cs_request
    chunk_data = malloc(sizeof(chunk_data[0]) * size);
    if (!chunk_data) {
       result = VK_ERROR_OUT_OF_HOST_MEMORY;
-      goto error_out;
+      PS4_FAIL(error_out);
    }
 
    num_chunks = request->number_of_ibs;
@@ -1921,7 +1928,7 @@ radv_amdgpu_cs_submit(struct radv_amdgpu_ctx *ctx, struct radv_amdgpu_cs_request
       }
       if (!wait_syncobj) {
          result = VK_ERROR_OUT_OF_HOST_MEMORY;
-         goto error_out;
+         PS4_FAIL(error_out);
       }
       num_chunks++;
 
@@ -1939,7 +1946,7 @@ radv_amdgpu_cs_submit(struct radv_amdgpu_ctx *ctx, struct radv_amdgpu_cs_request
       }
       if (!signal_syncobj) {
          result = VK_ERROR_OUT_OF_HOST_MEMORY;
-         goto error_out;
+         PS4_FAIL(error_out);
       }
       num_chunks++;
    }
-- 
