From dc49520b6f31cd233f75e4d32e9b0a5e65ff2071 Mon Sep 17 00:00:00 2001
From: ps4-kit <ps4-kit@localhost>
Date: Sun, 25 Oct 2026 03:11:22 +0300
Subject: [PATCH 28/35] PS4: no shader re-emit or L2 prefetch when a pipeline
 switch keeps the same shaders (pipeline switch 0.246 -> 0.113 us on the PC
 host build)

---
 src/amd/vulkan/radv_cmd_buffer.c | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 63ac834c188..39b2f11cd62 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -3930,6 +3930,23 @@ radv_emit_graphics_shaders(struct radv_cmd_buffer *cmd_buffer)
    }
 }
 
+/* PS4: two graphics pipelines with the very same shader objects (an emulator's pipelines often differ only in
+ * blend, depth or raster state around one shader pair). Their shader registers are identical, so a switch
+ * between them needs neither the shader registers emitted again nor the shaders prefetched into L2 again:
+ * on the PS4 that work made a pipeline switch cost ~2.6 us of CPU time per draw (kit-test v00.02), and the
+ * prefetch is CP DMA work for the GPU on every switch. */
+static bool
+radv_ps4_same_graphics_shaders(const struct radv_graphics_pipeline *a, const struct radv_graphics_pipeline *b)
+{
+   if (a->active_stages != b->active_stages || a->base.gs_copy_shader != b->base.gs_copy_shader)
+      return false;
+   radv_foreach_stage (s, a->active_stages & RADV_GRAPHICS_STAGE_BITS) {
+      if (a->base.shaders[s] != b->base.shaders[s])
+         return false;
+   }
+   return true;
+}
+
 static void
 radv_emit_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer)
 {
@@ -3940,7 +3957,11 @@ radv_emit_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer)
    if (cmd_buffer->state.emitted_graphics_pipeline == pipeline)
       return;
 
-   radv_emit_graphics_shaders(cmd_buffer);
+   /* (emitted_graphics_pipeline is reset wherever the shader registers may no longer be ours: a new command
+    * buffer, shader objects; meta operations bind pipelines of their own.) */
+   const struct radv_graphics_pipeline *emitted = cmd_buffer->state.emitted_graphics_pipeline;
+   if (!emitted || !radv_ps4_same_graphics_shaders(emitted, pipeline))
+      radv_emit_graphics_shaders(cmd_buffer);
 
    if (pipeline->sqtt_shaders_reloc) {
       /* Emit shaders relocation because RGP requires them to be contiguous in memory. */
@@ -8860,6 +8881,9 @@ radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_grap
    if (cmd_buffer->state.graphics_pipeline == graphics_pipeline)
       return;
 
+   const struct radv_graphics_pipeline *previous = cmd_buffer->state.graphics_pipeline;
+   const bool same_shaders = previous && radv_ps4_same_graphics_shaders(previous, graphics_pipeline);
+
    radv_foreach_stage (
       stage, (cmd_buffer->state.active_stages | graphics_pipeline->active_stages) & RADV_GRAPHICS_STAGE_BITS) {
       radv_bind_shader(cmd_buffer, graphics_pipeline->base.shaders[stage], stage);
@@ -8872,8 +8896,9 @@ radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_grap
    cmd_buffer->state.dirty |= RADV_CMD_DIRTY_PIPELINE;
    cmd_buffer->push_constant_stages |= graphics_pipeline->active_stages;
 
-   /* Prefetch all pipeline shaders at first draw time. */
-   cmd_buffer->state.prefetch_L2_mask |= RADV_PREFETCH_GFX_SHADERS;
+   /* Prefetch all pipeline shaders at first draw time (not again for the same shaders). */
+   if (!same_shaders)
+      cmd_buffer->state.prefetch_L2_mask |= RADV_PREFETCH_GFX_SHADERS;
 
    const struct radv_shader *ps = radv_get_shader(graphics_pipeline->base.shaders, MESA_SHADER_FRAGMENT);
 
