From 2b09301b2ecdc0475dc070f1e27b6d7769077273 Mon Sep 17 00:00:00 2001
From: ps4-kit <ps4-kit@localhost>
Date: Mon, 19 Oct 2026 07:42:50 +0300
Subject: [PATCH 21/35] PS4: GS rings at least ac_ps4_gs_ring_min (8 MiB) - the
 VGT wraps them at a larger size than RADV programs

---
 src/amd/vulkan/radv_queue.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
index d4dc52df7c5..0661c6a567b 100644
--- a/src/amd/vulkan/radv_queue.c
+++ b/src/amd/vulkan/radv_queue.c
@@ -41,7 +41,14 @@ void ac_ps4_trace(const char *fmt, ...);
  * on the PS4 the GS wrote at least 2 MiB into a 1.25 MiB GS->VS ring (Donkey Kong Country:
  * Tropical Freeze, every crash at the ring's base + 0x200000) - on Linux such writes land in the
  * next buffer or are dropped by the VM, on the PS4 a GPU page fault ends the app. */
-#define PS4_RING_ALLOC(size) MAX2((size) * 4, 4u << 20)
+#define PS4_RING_ALLOC(size) MAX2((size) * 2, 4u << 20)
+/* The GS rings as RADV sizes them (VGT_*_RING_SIZE, the descriptors' bounds) at least this large
+ * (bytes, 0 = RADV's sizes). Register read-back does not work on the PS4, but the GS writes past the
+ * programmed GS->VS ring (above), so the VGT apparently wraps the rings at a size of the system's,
+ * larger than RADV's: what the GS wrote past RADV's size the copy shader then reads outside its
+ * descriptor's bounds - as zeros - and those primitives vanish (Super Mario Maker's tiles, a
+ * different set every frame). Crema setting GS Ring Size. */
+int ac_ps4_gs_ring_min = 8u << 20;
 #else
 #define PS4_FAIL(label) goto label
 #define PS4_RING_ALLOC(size) (size)
@@ -1318,6 +1325,15 @@ radv_update_preambles(struct radv_queue_state *queue, struct radv_device *device
       *has_follower |= !!cmd_buffer->gang.cs;
    }
 
+#ifdef __PS4__
+   if (ac_ps4_gs_ring_min) {
+      if (needs.esgs_ring_size)
+         needs.esgs_ring_size = MAX2(needs.esgs_ring_size, (uint32_t)ac_ps4_gs_ring_min);
+      if (needs.gsvs_ring_size)
+         needs.gsvs_ring_size = MAX2(needs.gsvs_ring_size, (uint32_t)ac_ps4_gs_ring_min);
+   }
+#endif
+
    /* Sanitize scratch size information. */
    needs.scratch_waves =
       needs.scratch_size_per_wave ? MIN2(needs.scratch_waves, UINT32_MAX / needs.scratch_size_per_wave) : 0;
-- 
