From 75a0e1e05eca10582a541ffa9d3dc57a43ee38b4 Mon Sep 17 00:00:00 2001
From: ShiroKlein <ihaideezi@gmail.com>
Date: Fri, 16 Oct 2026 06:07:17 +0300
Subject: [PATCH 15/34] PS4: VK_PRIMITIVE_TOPOLOGY_META_QUAD_LIST_PS4 (12)
 draws the GPU s own quad lists (DI_PT_QUADLIST)

---
 src/amd/vulkan/radv_cmd_buffer.c        | 1 +
 src/amd/vulkan/radv_pipeline_graphics.h | 4 ++++
 src/vulkan/util/vk_internal_exts.h      | 2 ++
 src/vulkan/util/vk_util.c               | 1 +
 4 files changed, 8 insertions(+)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 46373c4cc0f..ce2e9f5cd5f 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -6899,6 +6899,7 @@ static const struct radv_prim_vertex_count prim_size_table[] = {
    [V_008958_DI_PT_TRISTRIP] = {3, 1},      [V_008958_DI_PT_LINELIST_ADJ] = {4, 4},
    [V_008958_DI_PT_LINESTRIP_ADJ] = {4, 1}, [V_008958_DI_PT_TRILIST_ADJ] = {6, 6},
    [V_008958_DI_PT_TRISTRIP_ADJ] = {6, 2},  [V_008958_DI_PT_RECTLIST] = {3, 3},
+   [V_008958_DI_PT_QUADLIST] = {4, 4},
    [V_008958_DI_PT_LINELOOP] = {2, 1},      [V_008958_DI_PT_POLYGON] = {3, 1},
    [V_008958_DI_PT_2D_TRI_STRIP] = {0, 0},
 };
diff --git a/src/amd/vulkan/radv_pipeline_graphics.h b/src/amd/vulkan/radv_pipeline_graphics.h
index c4dfd25d4b5..04a7206d7c3 100644
--- a/src/amd/vulkan/radv_pipeline_graphics.h
+++ b/src/amd/vulkan/radv_pipeline_graphics.h
@@ -228,6 +228,8 @@ radv_conv_prim_to_gs_out(uint32_t topology, bool is_ngg)
       return V_028A6C_TRISTRIP;
    case V_008958_DI_PT_RECTLIST:
       return is_ngg ? V_028A6C_RECTLIST : V_028A6C_TRISTRIP;
+   case V_008958_DI_PT_QUADLIST:
+      return V_028A6C_TRISTRIP;
    default:
       assert(0);
       return 0;
@@ -299,6 +301,8 @@ radv_translate_prim(unsigned topology)
       return V_008958_DI_PT_PATCH;
    case VK_PRIMITIVE_TOPOLOGY_META_RECT_LIST_MESA:
       return V_008958_DI_PT_RECTLIST;
+   case VK_PRIMITIVE_TOPOLOGY_META_QUAD_LIST_PS4:
+      return V_008958_DI_PT_QUADLIST;
    default:
       UNREACHABLE("unhandled primitive type");
    }
diff --git a/src/vulkan/util/vk_internal_exts.h b/src/vulkan/util/vk_internal_exts.h
index 497d28bd40b..d912d660394 100644
--- a/src/vulkan/util/vk_internal_exts.h
+++ b/src/vulkan/util/vk_internal_exts.h
@@ -24,6 +24,8 @@ extern "C" {
 #endif
 
 #define VK_PRIMITIVE_TOPOLOGY_META_RECT_LIST_MESA (VkPrimitiveTopology)11
+/* PS4 (Crema): the GPU's own quad lists (DI_PT_QUADLIST), as the Wii U's GPU draws quads */
+#define VK_PRIMITIVE_TOPOLOGY_META_QUAD_LIST_PS4 (VkPrimitiveTopology)12
 #define VK_IMAGE_VIEW_CREATE_DRIVER_INTERNAL_BIT_MESA \
    (VkImageViewCreateFlagBits)0x80000000
 
diff --git a/src/vulkan/util/vk_util.c b/src/vulkan/util/vk_util.c
index 289b8acfeab..9402eed33d5 100644
--- a/src/vulkan/util/vk_util.c
+++ b/src/vulkan/util/vk_util.c
@@ -157,6 +157,7 @@ vk_topology_to_mesa(VkPrimitiveTopology topology)
 PRAGMA_DIAGNOSTIC_PUSH
 PRAGMA_DIAGNOSTIC_IGNORED(-Wswitch)
    case VK_PRIMITIVE_TOPOLOGY_META_RECT_LIST_MESA:
+   case VK_PRIMITIVE_TOPOLOGY_META_QUAD_LIST_PS4:
 PRAGMA_DIAGNOSTIC_POP
       return MESA_PRIM_TRIANGLES;
    case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
-- 
