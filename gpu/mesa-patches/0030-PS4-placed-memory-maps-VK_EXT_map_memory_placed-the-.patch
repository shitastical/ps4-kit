From 7eab6c549763ce53efa043687cce06aa8f99ee4e Mon Sep 17 00:00:00 2001
From: ps4-kit <ps4-kit@localhost>
Date: Fri, 6 Nov 2026 02:15:26 +0300
Subject: [PATCH 30/34] PS4: placed memory maps (VK_EXT_map_memory_placed): the
 buffer's direct memory mapped once more at the application's address,
 reserved again on unmap and on destroy (Wine's 32-bit processes: DXVK failed
 to map its memory, VK_ERROR_MEMORY_MAP_FAILED)

---
 src/amd/common/ac_linux_drm.h                 |  8 +++++
 src/amd/common/ac_ps4_drm.c                   | 36 +++++++++++++++++++
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c | 13 ++++++-
 3 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/src/amd/common/ac_linux_drm.h b/src/amd/common/ac_linux_drm.h
index 33005e5afcb..4d89ddb9dc3 100644
--- a/src/amd/common/ac_linux_drm.h
+++ b/src/amd/common/ac_linux_drm.h
@@ -372,6 +372,14 @@ struct ac_drm_bo_import_result {
    uint64_t alloc_size;
 };
 
+#ifdef __PS4__
+/* VK_EXT_map_memory_placed: a buffer's memory mapped once more, at the application's address (Wine's
+ * 32-bit processes put every mapping below 4 GiB, in address space they reserved); and that address
+ * back to the application, reserved again (reserve) or given up. false: the buffer had no such map. */
+int ac_ps4_bo_cpu_map_placed(ac_drm_device *dev, ac_drm_bo bo, void *addr);
+bool ac_ps4_bo_cpu_unmap_placed(ac_drm_device *dev, ac_drm_bo bo, bool reserve);
+#endif
+
 
 PROC int ac_drm_device_initialize(int fd, bool is_virtio,
                                   uint32_t *major_version, uint32_t *minor_version,
diff --git a/src/amd/common/ac_ps4_drm.c b/src/amd/common/ac_ps4_drm.c
index fb0aea0ac01..95f6c306a6a 100644
--- a/src/amd/common/ac_ps4_drm.c
+++ b/src/amd/common/ac_ps4_drm.c
@@ -98,6 +98,7 @@ struct amdgpu_bo {
    bool tail_reported;
    bool gpu_ro; /* mapped GPU read-only (command buffers) */
    bool write_combined; /* garlic memory (VRAM); else CPU-cached onion */
+   void *placed; /* its memory once more at the application's address (ac_ps4_bo_cpu_map_placed) */
 };
 
 struct amdgpu_va {
@@ -1380,6 +1381,41 @@ ac_drm_bo_cpu_unmap(ac_drm_device *dev, ac_drm_bo bo)
    return 0;
 }
 
+int
+ac_ps4_bo_cpu_map_placed(ac_drm_device *dev, ac_drm_bo bo, void *addr)
+{
+   struct amdgpu_bo *b = bo.abo;
+   void *at = addr;
+
+   if (b->placed || ((uintptr_t)addr & (PS4_PAGE - 1)) ||
+       sceKernelMapDirectMemory(&at, b->size, PS4_PROT_CPU_RW, PS4_MAP_FIXED, b->phys, PS4_PAGE) || at != addr) {
+      ps4_log("radv/ps4: placed cpu map of bo %u at %p (%#llx bytes) failed\n", b->handle, addr,
+              (unsigned long long)b->size);
+      return -ENOMEM;
+   }
+   if (b->write_combined)
+      ps4_flush_cpu_cache(addr, b->size);
+   b->placed = addr;
+   return 0;
+}
+
+bool
+ac_ps4_bo_cpu_unmap_placed(ac_drm_device *dev, ac_drm_bo bo, bool reserve)
+{
+   struct amdgpu_bo *b = bo.abo;
+   void *at = b->placed;
+
+   if (!at)
+      return false;
+   b->placed = NULL;
+   /* (as Wine's PS4 memory layer turns its pages back into a reservation) */
+   sceKernelMunmap(at, b->size);
+   if (reserve && !ps4_reserve((uint64_t)(uintptr_t)at, b->size))
+      ps4_log("radv/ps4: reserving %p (%#llx bytes) again after a placed map failed\n", at,
+              (unsigned long long)b->size);
+   return true;
+}
+
 int
 ac_drm_bo_set_metadata(ac_drm_device *dev, uint32_t bo_handle, struct amdgpu_bo_metadata *info)
 {
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index b8c79c92941..de7a9833d88 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -477,6 +477,10 @@ radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo
 #ifndef __PS4__ /* the CPU mapping is the GPU mapping (ac_ps4_drm.c) */
    if (bo->cpu_map)
       munmap(bo->cpu_map, bo->base.size);
+#else
+   /* a placed map still there (freed while mapped): its address back to the application now, before
+    * the deferred free, which may come after the application gave the address up */
+   ac_ps4_bo_cpu_unmap_placed(ws->dev, bo->bo, true);
 #endif
 
    if (ws->debug_all_bos)
@@ -808,7 +812,13 @@ radv_amdgpu_winsys_bo_map(struct radeon_winsys *_ws, struct radeon_winsys_bo *_b
    {
       struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
       void *data = NULL;
-      if (use_fixed_addr || ac_drm_bo_cpu_map(ws->dev, bo->bo, &data))
+      if (use_fixed_addr) {
+         if (ac_ps4_bo_cpu_map_placed(ws->dev, bo->bo, fixed_addr))
+            return NULL;
+         bo->cpu_map = fixed_addr;
+         return fixed_addr;
+      }
+      if (ac_drm_bo_cpu_map(ws->dev, bo->bo, &data))
          return NULL;
       bo->cpu_map = data;
       return data;
@@ -843,6 +853,7 @@ radv_amdgpu_winsys_bo_unmap(struct radeon_winsys *_ws, struct radeon_winsys_bo *
 
    assert(bo->cpu_map);
 #ifdef __PS4__
+   ac_ps4_bo_cpu_unmap_placed(radv_amdgpu_winsys(_ws)->dev, bo->bo, replace);
    bo->cpu_map = NULL;
    return;
 #endif
-- 
