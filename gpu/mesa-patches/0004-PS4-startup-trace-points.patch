From bf612191fda9a12b3c6e69c6913919682debfe22 Mon Sep 17 00:00:00 2001
From: ShiroKlein <23220202+iHaiDeeZ@users.noreply.github.com>
Date: Fri, 2 Oct 2026 13:44:12 +0300
Subject: [PATCH 04/34] PS4: startup trace points

---
 src/amd/common/ac_linux_drm.h                     |  1 +
 src/amd/common/ac_ps4_drm.c                       | 12 ++++++++++++
 src/amd/vulkan/radv_physical_device.c             | 14 ++++++++++++++
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c | 10 ++++++++++
 4 files changed, 37 insertions(+)

diff --git a/src/amd/common/ac_linux_drm.h b/src/amd/common/ac_linux_drm.h
index a5f000581d1..d447567a25c 100644
--- a/src/amd/common/ac_linux_drm.h
+++ b/src/amd/common/ac_linux_drm.h
@@ -322,6 +322,7 @@ typedef struct amdgpu_va *amdgpu_va_handle;
 #include <stdio.h>
 int ac_ps4_fprintf(FILE *f, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
 #define fprintf ac_ps4_fprintf
+void ac_ps4_trace(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
 #endif
 
 #ifdef __cplusplus
diff --git a/src/amd/common/ac_ps4_drm.c b/src/amd/common/ac_ps4_drm.c
index 1b3945ab95f..b55b7767357 100755
--- a/src/amd/common/ac_ps4_drm.c
+++ b/src/amd/common/ac_ps4_drm.c
@@ -1445,3 +1445,15 @@ drmGetFormatModifierName(uint64_t modifier)
 {
    return NULL;
 }
+
+/* Trace points in RADV's startup (PS4_TRACE in the patched Mesa sources). */
+void
+ac_ps4_trace(const char *fmt, ...)
+{
+   char line[256];
+   va_list args;
+   va_start(args, fmt);
+   vsnprintf(line, sizeof(line), fmt, args);
+   va_end(args);
+   ps4_log("%s", line);
+}
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 3a3a7b85a00..32994812552 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -53,6 +53,13 @@ typedef void *drmDevicePtr;
 #define RADV_SUPPORT_CALIBRATED_TIMESTAMPS 1
 #endif
 
+#ifdef __PS4__
+void ac_ps4_trace(const char *fmt, ...);
+#define PS4_TRACE(...) ac_ps4_trace(__VA_ARGS__)
+#else
+#define PS4_TRACE(...)
+#endif
+
 static bool
 radv_perf_query_supported(const struct radv_physical_device *pdev)
 {
@@ -2289,6 +2296,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    return VK_ERROR_INCOMPATIBLE_DRIVER;
 #else
    VkResult result;
+   PS4_TRACE("radv: try_create\n");
    int fd = -1;
    int master_fd = -1;
    bool is_virtio = false;
@@ -2349,6 +2357,7 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    vk_physical_device_dispatch_table_from_entrypoints(&dispatch_table, &wsi_physical_device_entrypoints, false);
 
    result = vk_physical_device_init(&pdev->vk, &instance->vk, NULL, NULL, NULL, &dispatch_table);
+   PS4_TRACE("radv: vk_physical_device_init = %d\n", result);
    if (result != VK_SUCCESS) {
       goto fail_alloc;
    }
@@ -2594,19 +2603,24 @@ radv_physical_device_try_create(struct radv_instance *instance, drmDevicePtr drm
    return VK_SUCCESS;
 
 fail_perfcounters:
+   PS4_TRACE("radv: try_create -> fail_perfcounters (%d)\n", result);
    ac_destroy_perfcounters(&pdev->ac_perfcounters);
    disk_cache_destroy(pdev->vk.disk_cache);
    disk_cache_destroy(pdev->disk_cache_meta);
 fail_wsi:
+   PS4_TRACE("radv: try_create -> fail_wsi (%d)\n", result);
    if (pdev->addrlib)
       ac_addrlib_destroy(pdev->addrlib);
    if (pdev->ws)
       pdev->ws->destroy(pdev->ws);
 fail_base:
+   PS4_TRACE("radv: try_create -> fail_base (%d)\n", result);
    vk_physical_device_finish(&pdev->vk);
 fail_alloc:
+   PS4_TRACE("radv: try_create -> fail_alloc (%d)\n", result);
    vk_free(&instance->vk.alloc, pdev);
 fail_fd:
+   PS4_TRACE("radv: try_create -> fail_fd (%d)\n", result);
    if (fd != -1)
       close(fd);
    if (master_fd != -1)
diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
index 438b4341220..c836a6ec572 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_winsys.c
@@ -22,6 +22,13 @@
 #include "vk_drm_syncobj.h"
 #include "xf86drm.h"
 
+#ifdef __PS4__
+void ac_ps4_trace(const char *fmt, ...);
+#define PS4_TRACE(...) ac_ps4_trace(__VA_ARGS__)
+#else
+#define PS4_TRACE(...)
+#endif
+
 static void
 radv_amdgpu_winsys_query_info(struct radeon_winsys *rws, struct radeon_info *gpu_info)
 {
@@ -207,6 +214,7 @@ radv_amdgpu_winsys_create(int fd, uint64_t debug_flags, uint64_t perftest_flags,
 
    perftest_flags = radv_amdgpu_winsys_filter_perftest_flags(perftest_flags);
 
+   PS4_TRACE("radv: winsys_create\n");
    r = ac_drm_device_initialize(fd, is_virtio, &drm_major, &drm_minor, &dev);
    if (r) {
       fprintf(stderr, "radv/amdgpu: failed to initialize device.\n");
@@ -270,6 +278,7 @@ radv_amdgpu_winsys_create(int fd, uint64_t debug_flags, uint64_t perftest_flags,
    ws->info.is_virtio = is_virtio;
 
    enum ac_query_gpu_info_result info_result = ac_query_gpu_info(fd, ws->dev, &ws->info, true);
+   PS4_TRACE("radv: ac_query_gpu_info = %d\n", info_result);
    if (info_result != AC_QUERY_GPU_INFO_SUCCESS) {
       result = info_result == AC_QUERY_GPU_INFO_FAIL ? VK_ERROR_INITIALIZATION_FAILED : VK_ERROR_INCOMPATIBLE_DRIVER;
       goto winsys_fail;
@@ -355,6 +364,7 @@ radv_amdgpu_winsys_create(int fd, uint64_t debug_flags, uint64_t perftest_flags,
    return result;
 
 winsys_fail:
+   PS4_TRACE("radv: winsys_create -> winsys_fail (%d)\n", result);
    free(ws);
 fail:
    if (winsyses && _mesa_hash_table_num_entries(winsyses) == 0) {
-- 
2.43.0

