From 8c91486ff33b28002f10008605bd2024cf532e4b Mon Sep 17 00:00:00 2001
From: ps4-kit <ps4-kit@localhost>
Date: Thu, 19 Nov 2026 17:22:51 -0500
Subject: [PATCH 34/35] PS4: call sceGnmSubmitDone after the flip is made,
 never at submit time

sceGnmSubmitDone promises the kernel the GPU can go idle within 500 ms. Calling it while the frame and its uploads were still queued made texture loading hit GPU_FAULT_SUBMITDONE_TIMEOUT_IN_SUSPEND_ASYNC. The WSI now calls ac_ps4_submit_done() when VideoOut reports the flip made; the submit thread never calls it.
---
 src/amd/common/ac_ps4_drm.c | 28 +++++++++++++++++++---------
 1 file changed, 19 insertions(+), 9 deletions(-)

diff --git a/src/amd/common/ac_ps4_drm.c b/src/amd/common/ac_ps4_drm.c
index d131b301789..6f6fdd4939b 100644
--- a/src/amd/common/ac_ps4_drm.c
+++ b/src/amd/common/ac_ps4_drm.c
@@ -2579,6 +2579,17 @@ static pthread_cond_t ps4_job_space = PTHREAD_COND_INITIALIZER;
 static bool ps4_job_thread_started;
 void ps4_boost_thread(void); /* port/ps4_runtime.cpp: above the default priority */
 
+/* The WSI calls this when VideoOut reports a flip made, i.e. after that frame's GPU work is done. */
+static ac_drm_device *ps4_submit_dev;
+void ac_ps4_submit_done(void);
+void
+ac_ps4_submit_done(void)
+{
+   ac_drm_device *dev = __atomic_load_n(&ps4_submit_dev, __ATOMIC_ACQUIRE);
+   if (dev && dev->submit_done)
+      dev->submit_done();
+}
+
 static void
 ps4_fence_at_least(ac_drm_device *dev, uint64_t seq)
 {
@@ -2601,22 +2612,16 @@ ps4_submit_thread(void *arg)
       pthread_mutex_unlock(&ps4_job_lock);
 
       ac_drm_device *dev = job->dev;
+      __atomic_store_n(&ps4_submit_dev, dev, __ATOMIC_RELEASE);
+      const bool flip = job->flip;
       void *ccb[68] = {0};
       uint32_t ccb_sizes[68] = {0};
       int r;
-      if (job->flip)
+      if (flip)
          r = dev->submit_and_flip(job->num_ibs, job->dcb, job->dcb_sizes, ccb, ccb_sizes, job->video,
                                   job->buffer, job->mode, job->arg);
       else
          r = dev->submit(job->num_ibs, job->dcb, job->dcb_sizes, ccb, ccb_sizes);
-      /* sceGnmSubmitDone tells the system the frame's work is in, and the kernel then expects the
-       * GPU to fall idle within 500 ms ("GPU failed to become idle within 500 ms after submitDone",
-       * and after enough of those GPU_FAULT_SUBMITDONE_TIMEOUT_IN_SUSPEND_ASYNC). A texture upload
-       * queue keeps the GPU busy far longer than that, so the old "at least every 4 ms" fallback
-       * turned a loading screen into a GPU fault, a frozen app and a console whose shell had to
-       * restart. Only a flip ends a frame: one submitDone after it, none while work is queued. */
-      if (job->flip)
-         dev->submit_done();
       if (r) {
          static unsigned logged;
          if (logged++ < 8)
@@ -2630,6 +2635,11 @@ ps4_submit_thread(void *arg)
       ps4_job_head++;
       pthread_cond_signal(&ps4_job_space);
       pthread_mutex_unlock(&ps4_job_lock);
+      /* sceGnmSubmitDone is *not* called here. It promises the kernel that the GPU can go idle
+       * within 500 ms; calling it at submit time, while this frame and the uploads behind it are
+       * still running, is what produced GPU_FAULT_SUBMITDONE_TIMEOUT_IN_SUSPEND_ASYNC. The WSI
+       * calls ac_ps4_submit_done() when VideoOut reports the flip made, i.e. after the frame's
+       * work is actually done. */
    }
    return NULL;
 }
