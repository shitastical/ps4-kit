From 878019994b1a952c656240e452fba9d2aab898fb Mon Sep 17 00:00:00 2001
From: ShiroKlein <ihaideezi@gmail.com>
Date: Fri, 30 Oct 2026 23:39:55 +0300
Subject: [PATCH 29/34] PS4: wait-only submissions (no command buffers) wait
 for their points to be submitted instead of exporting sync files (ENOSYS:
 lost the device)

---
 src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
index 03c1209e1a5..52a46c5340d 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_cs.c
@@ -1289,7 +1289,30 @@ radv_amdgpu_cs_submit_zero(struct radv_amdgpu_ctx *ctx, enum amd_ip_type ip_type
    if (!queue_syncobj)
       return VK_ERROR_OUT_OF_HOST_MEMORY;
 
+#ifdef __PS4__
+   /* PS4 port: there are no sync files (export/import are ENOSYS, and every wait-only submission -
+    * DXVK's syncSdma one, Tekken Tag 2's first boot - lost the device). The GPU has one in-order
+    * queue, so a wait only has to make sure the work it waits for was submitted (as the IB path's
+    * SYNCOBJ_IN chunks do): later submissions run after it. The signals below take the queue's
+    * last submission. */
+   if (sem_info->wait.syncobj_count) {
+      ret = ac_drm_cs_syncobj_wait(ctx->ws->dev, sem_info->wait.syncobj, sem_info->wait.syncobj_count, INT64_MAX,
+                                   DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE, NULL);
+      if (ret < 0)
+         return VK_ERROR_DEVICE_LOST;
+   }
+   if (sem_info->wait.timeline_syncobj_count) {
+      ret = ac_drm_cs_syncobj_timeline_wait(ctx->ws->dev, sem_info->wait.syncobj + sem_info->wait.syncobj_count,
+                                            sem_info->wait.points, sem_info->wait.timeline_syncobj_count, INT64_MAX,
+                                            DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE,
+                                            NULL);
+      if (ret < 0)
+         return VK_ERROR_DEVICE_LOST;
+   }
+   if (false) {
+#else
    if (sem_info->wait.syncobj_count || sem_info->wait.timeline_syncobj_count) {
+#endif
       int fd;
       ret = ac_drm_cs_syncobj_export_sync_file(ctx->ws->dev, queue_syncobj, &fd);
       if (ret < 0)
-- 
